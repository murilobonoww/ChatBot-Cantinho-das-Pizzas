{
    "compilerOptions": {
        "target": "ESNext",
        "allowJs": true,
        "checkJs": true,
        "module": "commonJS",
        "rootDir": "src",
        "outDir": "dist",
        "sourceMap": true,
        "moduleResolution": "Node",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noImplicitAny": true,
        "types": ["jest", "node"],
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "declaration": true,
        "allowSyntheticDefaultImports": true,
        "lib": [
            "ES2022",
            "DOM"
        ]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}